# Local tooling and editor debris — patterns live in .git/info/exclude (untracked)
# so this file stays free of developer-machine specifics.

# Build outputs
*.exe
*.dll
*.pdb
*.zip

# .NET
bin/
obj/
packages/
*.user
*.suo
*.cache
*.log

# Node / web-panel
node_modules/
dist/
*.tsbuildinfo

# Temporary build artifacts
.tmp/
.vs/

# Project-specific
appsettings.json
.source
*DotSettings.user
web-panel/bridge/wand-remote-bridge.cjs
