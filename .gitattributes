# Normalize line endings — stop the LF/CRLF churn that pollutes diffs.
# C# and XAML use CRLF (Windows convention, matches the existing repo).
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.iss text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.config text eol=crlf
*.json text eol=crlf
*.resx text eol=crlf

# Web panel sources are LF. Without these the formatter step in `pnpm run lint`
# reports every CRLF line as an error on a Windows checkout, so `build.ps1`
# aborts at the lint step before it builds anything.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.po text eol=lf

# Markdown uses LF (cross-platform convention).
*.md text eol=lf

# Binary files — no line ending normalization.
*.exe binary
*.dll binary
*.pdb binary
*.ico binary
*.woff2 binary
*.webp binary
*.png binary
*.jpg binary
*.svg binary
*.ttf binary